{
 "doc": "The menu router's registry (1.1 §d, native map P6): every vanilla surface Argonia takes over and what replaces it. One row per surface; a surface's hook is installed once by ArgoniaCore and each system registers one handler. replacement: view (our view, named in `by`), suppressed (never shown; `by` names the flow that runs instead, if any), restyled (the vanilla behaviour kept under our theme). `menu` is the CommonLibSSE-NG menu name (re-checked against the pinned CommonLib at S10a/S11a); `inventory` the immersion inventory row. Generated into skse/core/generated/argonia/core/router_table.h by tools/schema_gen; read by the 2.2 UI map and the immersion inventory.",
 "kinds": [
  "menu",
  "dialogue",
  "death",
  "levelUp",
  "hud",
  "notification"
 ],
 "replacements": [
  "view",
  "suppressed",
  "restyled"
 ],
 "hooks": [
  {
   "id": "menuOpenClose",
   "mechanism": "MenuOpenCloseEvent sink; a blocked menu is closed through the UI message queue the frame it opens",
   "chunk": "1.1 §d"
  },
  {
   "id": "dialogueIntercept",
   "mechanism": "P3: a player perk's Activate entry point (Run Immediately, Replace Default) on Argonia speakers calls ArgoniaCore's open-dialogue native; fallback the guarded activate-slot swap (route 6); Dialogue Menu blocked by menuOpenClose as the backstop",
   "chunk": "1.3 §b"
  },
  {
   "id": "deathIntercept",
   "mechanism": "the Respawn - Soulslike pattern: the player kept essential, a TESEnterBleedoutEvent sink runs our respawn instead of the death camera and the load of the last save",
   "chunk": "1.5"
  },
  {
   "id": "progressionOff",
   "mechanism": "P4: vanilla skill gain and character XP off by data (AVSK useMult 0, fXPPerSkillRank 0); the router only checks LevelUp Menu never opens, a hook only if S16a finds a gain path",
   "chunk": "1.5"
  },
  {
   "id": "hudElements",
   "mechanism": "the HUD movie's clips (router::kHudClips: Health, Magica, Stamina, CompassShoutMeterHolder under _root.HUDMovieBaseInstance) set _visible false and taken out of its HudElements list, at each HUD Menu opening and load, while our views are bound; no INI setting is written (bShowCompass would persist into the player's SkyrimPrefs.ini). L4 owed (lane ui-gaps)",
   "chunk": "1.2 §d"
  },
  {
   "id": "notifications",
   "mechanism": "the HUD's notification queue intercepted (quest, discovery, skill and one-line engine messages) and re-sent as our notices (mechanism UNVERIFIED)",
   "chunk": "1.2 §d"
  }
 ],
