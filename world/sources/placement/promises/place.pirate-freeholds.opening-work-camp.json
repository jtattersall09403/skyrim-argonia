    {
      "id": "promise.opening-work-camp.prose-why-founding",
      "kind": "prose",
      "source": {
        "file": "world/sources/catalogue/places-pirate-freeholds.json",
        "path": "places[place.pirate-freeholds.opening-work-camp].why.founding"
      },
      "text": "A gang that works a channel has to sleep on land. The families follow it. The camp is forty years old and is still named for the ground worked by the gang.",
      "confirmed": {
        "sha": "fbf379bfa364",
        "note": "Two sleeping sheds, two family tents and the overseers' hut; the gang's walk joins the camp to the barge track."
