        "path": "places[place.pirate-freeholds.opening-work-camp].playerPurpose.hook"
      },
      "text": "The gang's families live on this slope above the marsh. The warm shed at the top holds the gang's egg clutch. The families will not move away from it.",
      "confirmed": {
        "sha": "c7ce0e9c605d",
        "note": "The hatching shed (b-hatch) stands on the top terrace below the Border road; the families' sheds and tents step down the slope below it.",
        "ids": [
          "place.pirate-freeholds.opening-work-camp.parcel.opening-work-camp.hatching-shed.building"
        ]
      }
    },
    {
