{
 "schemaVersion": 1,
 "placeId": "place.route.archon-gideon-mere-neck",
 "facts": [
  {
   "id": "fact.archon-gideon-mere-neck.why-founding-1",
   "claim": "The Long road from Archon to Gideon crosses a strip of ground between two meres, barely higher than the water.",
   "sourceField": "why.founding",
   "kind": "feature",
   "carrier": {
    "built": {
     "uid": "pl-n00",
     "type": "piece-set"
    }
   }
  },
  {
   "id": "fact.archon-gideon-mere-neck.why-siteAdvantages-1",
   "claim": "The neck is the only dry line between the meres for a long way.",
   "sourceField": "why.siteAdvantages",
   "kind": "feature",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "rumour.gideon"
    }
   }
  },
  {
   "id": "fact.archon-gideon-mere-neck.why-siteAdvantages-2",
   "claim": "For about fifty metres the mere covers the north half of the road, knee-deep and in places to the waist.",
   "sourceField": "why.siteAdvantages",
   "kind": "feature",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "rumour.sunken-causeway"
    }
   }
  },
  {
   "id": "fact.archon-gideon-mere-neck.why-occupantsMotive-1",
   "claim": "Travellers have driven poles into both verges so a walker can keep to the causeway when the water covers it.",
   "sourceField": "why.occupantsMotive",
   "kind": "feature",
   "carrier": {
    "built": {
     "uid": "pl-n00",
     "type": "piece-set"
    }
   }
  },
  {
   "id": "fact.archon-gideon-mere-neck.why-pressures-1",
   "claim": "Poles mark the causeway verge.",
   "sourceField": "why.pressures",
   "kind": "feature",
   "carrier": {
    "built": {
     "uid": "pl-n00",
     "type": "piece-set"
    }
   }
  },
  {
   "id": "fact.archon-gideon-mere-neck.why-pressures-2",
   "claim": "A walker who strays off the causeway between the poles goes into deeper water.",
   "sourceField": "why.pressures",
   "kind": "feature",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "rumour.sunken-causeway"
    }
   }
  },
  {
   "id": "fact.archon-gideon-mere-neck.why-wouldChangeIf-1",
   "claim": "If the meres dried back, the poles would be left standing on dry ground.",
   "sourceField": "why.wouldChangeIf",
   "kind": "activity",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "npc.hist-heartland.greenspring.n1"
    }
   }
  },
  {
   "id": "fact.archon-gideon-mere-neck.why-wouldChangeIf-2",
   "claim": "Nobody would replace the poles.",
   "sourceField": "why.wouldChangeIf",
   "kind": "activity",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "npc.hist-heartland.greenspring.n1"
    }
   }
  }
 ],
