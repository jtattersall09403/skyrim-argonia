{
 "schemaVersion": 1,
 "placeId": "place.route.border-road-greenspring-crossings",
 "facts": [
  {
   "id": "fact.border-road-greenspring-crossings.why-founding-1",
   "claim": "The Border road was laid on a Dunmer line from Stormhold to Thorn.",
   "sourceField": "why.founding",
   "kind": "history",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "npc.hist-heartland.greenspring.n2"
    }
   }
  },
  {
   "id": "fact.border-road-greenspring-crossings.why-founding-2",
   "claim": "West of the Greenspring track the road drops off the ridge into the river marsh.",
   "sourceField": "why.founding",
   "kind": "feature",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "npc.hist-heartland.greenspring.n2"
    }
   }
  },
  {
   "id": "fact.border-road-greenspring-crossings.why-siteAdvantages-1",
   "claim": "The road keeps to the dry strip at the mountain foot.",
   "sourceField": "why.siteAdvantages",
   "kind": "feature",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "npc.hist-heartland.greenspring.n2"
    }
   }
  },
  {
   "id": "fact.border-road-greenspring-crossings.why-siteAdvantages-2",
   "claim": "The road crosses two reaches of the river marsh, where the water stands up to a metre and a quarter deep.",
   "sourceField": "why.siteAdvantages",
   "kind": "feature",
   "carrier": {
    "built": {
     "uid": "ib-03",
     "type": "visual-cue"
    }
   }
  },
  {
   "id": "fact.border-road-greenspring-crossings.why-occupantsMotive-1",
   "claim": "The people of Greenspring keep the planks in repair because their trade goes out along this road.",
   "sourceField": "why.occupantsMotive",
   "kind": "activity",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "npc.hist-heartland.greenspring.n1"
    }
   }
  },
  {
   "id": "fact.border-road-greenspring-crossings.why-pressures-1",
   "claim": "The marsh rots the piles in a few seasons. Greenspring has to move the station.",
   "sourceField": "why.pressures",
   "kind": "feature",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "npc.hist-heartland.greenspring.n2"
    }
   }
  },
  {
   "id": "fact.border-road-greenspring-crossings.why-wouldChangeIf-1",
   "claim": "A stone causeway would replace the planks if anyone paid for one.",
   "sourceField": "why.wouldChangeIf",
   "kind": "activity",
   "carrier": {
    "queued": {
     "type": "npc-topic",
     "ref": "npc.hist-heartland.greenspring.n2"
    }
   }
  }
 ],
