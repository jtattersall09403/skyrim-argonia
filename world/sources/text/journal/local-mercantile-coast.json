{
  "schemaVersion": 1,
  "domain": "journal-text",
  "_": "Journal and objective text for the mercantile-coast quests of the 2.11 slice (P4). Rendered by worldgen.place_text --emit-text.",
  "entries": [
    {
      "id": "text.journal.lm38.10",
      "questId": "quest.local.lm38",
      "surface": "journal",
      "text": "Sells-The-Last-Sack sells salvage at Chasepoint. She told me this week's lot came off a ship whose owners do not know it sank. I'm to ask Aelia Nerva, the station-keeper, who ought to be told.",
      "factIds": [
        "fact.chasepoint.unknowing-owners",
        "fact.salvage.wreckage"
      ],
      "groundedIn": [
        "fact.chasepoint.questHooks-opportunity-1",
        "fact.chasepoint.playerPurpose-hook-1",
        "fact.chasepoint.why-siteAdvantages-2"
      ]
    },
    {
      "id": "text.objective.lm38.ask-keeper",
      "questId": "quest.local.lm38",
      "surface": "journal",
      "text": "Ask Aelia Nerva who owns the sunk ship",
      "factIds": [],
      "groundedIn": [
        "fact.chasepoint.questHooks-opportunity-1"
      ]
    },
    {
      "id": "text.journal.lm38.20",
      "questId": "quest.local.lm38",
      "surface": "journal",
      "text": "Aelia Nerva heard me out about the salvage lot at Chasepoint. Whoever owned that ship will be found in Soulrest, west along the coast road.",
      "factIds": [
        "fact.chasepoint.unknowing-owners"
      ],
      "groundedIn": [
        "fact.chasepoint.questHooks-opportunity-1",
        "fact.chasepoint.why-founding-1"
      ]
    },
    {
      "id": "text.journal.lm38.90",
      "questId": "quest.local.lm38",
      "surface": "journal",
      "text": "Aelia Nerva is dead. The ship's owners will not hear of their loss through me.",
      "factIds": [],
      "groundedIn": [
        "fact.chasepoint.questHooks-opportunity-1"
      ]
    },
    {
      "id": "text.journal.lm57.10",
      "questId": "quest.local.lm57",
      "surface": "journal",
      "text": "Aelia Nerva keeps the road stage at Chasepoint. She told me no keeper there has been paid in two centuries. Two families each claim the office. I'm to hear Argues-With-The-Clerk out for one of the families.",
      "factIds": [
        "fact.chasepoint.unpaid-keeper",
        "fact.chasepoint.keeper-claim"
      ],
      "groundedIn": [
        "fact.chasepoint.why-pressures-1",
        "fact.chasepoint.why-founding-2",
        "fact.chasepoint.why-founding-3"
      ]
    },
    {
      "id": "text.objective.lm57.ask-household",
      "questId": "quest.local.lm57",
      "surface": "journal",
      "text": "Hear Argues-With-The-Clerk's claim to the keeper's office",
      "factIds": [],
      "groundedIn": [
        "fact.chasepoint.why-pressures-1"
      ]
    },
    {
      "id": "text.journal.lm57.20",
      "questId": "quest.local.lm57",
      "surface": "journal",
      "text": "Argues-With-The-Clerk told me his family's claim to the keeper's office at Chasepoint. The other family is at the Fourth Stage, further along the coast road.",
      "factIds": [
        "fact.chasepoint.keeper-claim"
      ],
      "groundedIn": [
        "fact.chasepoint.why-pressures-1",
        "fact.chasepoint.why-founding-1"
      ]
    },
    {
      "id": "text.journal.lm57.90",
      "questId": "quest.local.lm57",
      "surface": "journal",
      "text": "One of the two claimants at Chasepoint is dead. I cannot settle which family holds the keeper's office.",
      "factIds": [],
      "groundedIn": [
        "fact.chasepoint.why-pressures-1"
      ]
    },
    {
      "id": "text.journal.lm56.10",
      "questId": "quest.local.lm56",
      "surface": "journal",
      "text": "Aelia Nerva told me a road survey went out east of Soulrest to price a causeway repair. Then its word stopped coming back. Chasepoint is the last firm ground before the coast road turns inland. I'm to walk to The Tag House on the Prison road and look for the survey's trail.",
      "factIds": [
        "fact.chasepoint.last-firm-ground",
        "fact.tag-house.prison-road"
      ],
      "groundedIn": [
        "fact.chasepoint.why-siteAdvantages-1",
        "fact.chasepoint.why-founding-1",
        "fact.rose-bone-waystation.why-siteAdvantages-1"
      ]
    },
    {
      "id": "text.objective.lm56.walk-to-tag-house",
      "questId": "quest.local.lm56",
      "surface": "journal",
      "text": "Walk to The Tag House on the Prison road",
      "factIds": [],
      "groundedIn": [
        "fact.rose-bone-waystation.why-siteAdvantages-1"
      ]
    },
    {
      "id": "text.journal.lm56.20",
      "questId": "quest.local.lm56",
      "surface": "journal",
      "text": "I reached The Tag House, on its dry rise beside the Prison road. The survey's road runs on toward White-Rose Prison.",
      "factIds": [
        "fact.tag-house.prison-road"
      ],
      "groundedIn": [
        "fact.rose-bone-waystation.why-siteAdvantages-1"
      ]
    },
    {
      "id": "text.journal.lm56.90",
      "questId": "quest.local.lm56",
      "surface": "journal",
      "text": "Aelia Nerva is dead. The road survey was her concern.",
      "factIds": [],
      "groundedIn": [
        "fact.chasepoint.why-founding-1"
      ]
    },
    {
      "id": "text.journal.lq29.10",
      "questId": "quest.local.lq29",
      "surface": "journal",
      "text": "Aelia Nerva told me a wreck has come in on the bar south of Chasepoint. The salvage families will not work it. Buys-Cheap has been out to look. I'm to ask him what is aboard.",
      "factIds": [
        "fact.salvage.wreckage",
        "fact.chasepoint.salvage"
      ],
      "groundedIn": [
        "fact.chasepoint.why-siteAdvantages-2",
        "fact.chasepoint.why-founding-3"
      ]
    },
    {
      "id": "text.objective.lq29.ask-buyer",
      "questId": "quest.local.lq29",
      "surface": "journal",
      "text": "Ask Buys-Cheap what is aboard the wreck",
      "factIds": [],
      "groundedIn": [
        "fact.chasepoint.why-siteAdvantages-2"
      ]
    },
    {
      "id": "text.journal.lq29.20",
      "questId": "quest.local.lq29",
      "surface": "journal",
      "text": "Buys-Cheap told me what he saw aboard the wreck. The wreckers of the Long Bar have it now.",
      "factIds": [
        "fact.salvage.wreckage"
      ],
      "groundedIn": [
        "fact.chasepoint.why-siteAdvantages-2"
      ]
    },
    {
      "id": "text.journal.lq29.90",
      "questId": "quest.local.lq29",
      "surface": "journal",
      "text": "One of the two who knew about the wreck at Chasepoint is dead. I will hear no more of it there.",
      "factIds": [],
      "groundedIn": [
        "fact.chasepoint.why-siteAdvantages-2"
      ]
    },
    {
      "id": "text.journal.lm62.10",
      "questId": "quest.local.lm62",
      "surface": "journal",
      "text": "Sells-The-Last-Sack told me the wreckers who pull people off the bar keep them as salvage crew, to work off the cost of their own rescue. I'm to ask Opens-The-Second-Shed at Chasepoint what that rescue costs.",
      "factIds": [
        "fact.salvage.wreckage",
        "fact.salvage.hereditary"
      ],
      "groundedIn": [
        "fact.chasepoint.why-siteAdvantages-2",
        "fact.chasepoint.why-occupantsMotive-1"
      ]
    },
    {
      "id": "text.objective.lm62.ask-shed",
      "questId": "quest.local.lm62",
      "surface": "journal",
      "text": "Ask Opens-The-Second-Shed what a rescue off the bar costs",
      "factIds": [],
      "groundedIn": [
        "fact.chasepoint.why-siteAdvantages-2"
      ]
    },
    {
      "id": "text.journal.lm62.20",
      "questId": "quest.local.lm62",
      "surface": "journal",
      "text": "Opens-The-Second-Shed told me what a rescue off the bar costs. The crews who are working it off are with the wreckers of the Long Bar.",
      "factIds": [
        "fact.salvage.wreckage"
      ],
      "groundedIn": [
        "fact.chasepoint.why-siteAdvantages-2"
      ]
    },
    {
      "id": "text.journal.lm62.90",
      "questId": "quest.local.lm62",
      "surface": "journal",
      "text": "One of the two who spoke of the salvage crews at Chasepoint is dead. I will learn no more there.",
      "factIds": [],
      "groundedIn": [
        "fact.chasepoint.why-siteAdvantages-2"
      ]
    },
    {
      "id": "text.journal.lm08.10",
      "questId": "quest.local.lm08",
      "surface": "journal",
      "text": "Opens-The-Books speaks for the Lighter Flotilla. She told me the Lilmoth council wants every lighter licensed. The last time it tried, the crews stopped the port for two weeks. I'm to ask Xal-Jei what terms the crews would take.",
      "factIds": [
        "fact.flotilla.licence",
        "fact.flotilla.stopped-port"
      ],
      "groundedIn": [
        "fact.lighter-flotilla.why-pressures-1",
        "fact.lighter-flotilla.questHooks-opportunity-1",
        "fact.lighter-flotilla.why-occupantsMotive-1"
      ]
    },
    {
      "id": "text.objective.lm08.ask-master",
      "questId": "quest.local.lm08",
      "surface": "journal",
      "text": "Ask Xal-Jei what terms the crews would take",
      "factIds": [],
      "groundedIn": [
        "fact.lighter-flotilla.questHooks-opportunity-1"
      ]
    },
    {
      "id": "text.journal.lm08.20",
      "questId": "quest.local.lm08",
      "surface": "journal",
      "text": "Xal-Jei gave me the crews' terms. If the council opens the tariff, the crews will talk about a licence. I must carry them to the council in Lilmoth.",
      "factIds": [
        "fact.flotilla.licence",
        "fact.lilmoth.council"
      ],
      "groundedIn": [
        "fact.lighter-flotilla.questHooks-opportunity-1",
        "fact.lighter-flotilla.why-occupantsMotive-2"
      ]
    },
    {
      "id": "text.journal.lm08.90",
      "questId": "quest.local.lm08",
      "surface": "journal",
      "text": "One of the two I was to speak with on the flotilla is dead.",
      "factIds": [],
      "groundedIn": [
        "fact.lighter-flotilla.questHooks-opportunity-1"
      ]
    },
    {
      "id": "text.journal.lm23.10",
      "questId": "quest.local.lm23",
      "surface": "journal",
      "text": "Xal-Jei, master of a lighter, told me some cargo comes ashore at night and never touches the quay. It is settled at the dice tables. I'm to ask Reeh-Tei, who mends nets on the flotilla, what comes past at night.",
      "factIds": [
        "fact.lighter.cargo-ashore",
        "fact.flotilla.hidden-cache"
      ],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1",
        "fact.lighter-flotilla.why-occupantsMotive-1"
      ]
    },
    {
      "id": "text.objective.lm23.ask-mender",
      "questId": "quest.local.lm23",
      "surface": "journal",
      "text": "Ask Reeh-Tei what comes past the flotilla at night",
      "factIds": [],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1"
      ]
    },
    {
      "id": "text.journal.lm23.20",
      "questId": "quest.local.lm23",
      "surface": "journal",
      "text": "Reeh-Tei told me where the night cargo is settled: at the dice tables on the Outside Barge.",
      "factIds": [
        "fact.lighter.cargo-ashore"
      ],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1"
      ]
    },
    {
      "id": "text.journal.lm23.90",
      "questId": "quest.local.lm23",
      "surface": "journal",
      "text": "One of the two who spoke of the night cargo is dead. I can learn no more of the night cargo.",
      "factIds": [],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1"
      ]
    },
    {
      "id": "text.journal.tg04.10",
      "questId": "quest.tg.tg04",
      "surface": "journal",
      "text": "Ninx-Ossa keeps the purse for the Lighter Flotilla. She told me the speaker keeps a tally of cargo off a hull that never reached the quay. She wants the list. I must take it unseen.",
      "factIds": [
        "fact.flotilla.hidden-cache"
      ],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1",
        "fact.lighter-flotilla.vibe-signatureFeature-1"
      ]
    },
    {
      "id": "text.objective.tg04.take-tally",
      "questId": "quest.tg.tg04",
      "surface": "journal",
      "text": "Take the hull tally from the speaker's hull unseen",
      "factIds": [],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1"
      ]
    },
    {
      "id": "text.journal.tg04.20",
      "questId": "quest.tg.tg04",
      "surface": "journal",
      "text": "I took the list unseen. I must bring it to Ninx-Ossa.",
      "factIds": [],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1"
      ]
    },
    {
      "id": "text.objective.tg04.hand-tally",
      "questId": "quest.tg.tg04",
      "surface": "journal",
      "text": "Give the hull tally to Ninx-Ossa",
      "factIds": [],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1"
      ]
    },
    {
      "id": "text.journal.tg04.30",
      "questId": "quest.tg.tg04",
      "surface": "journal",
      "text": "I gave Ninx-Ossa the list. Now she knows what the hidden cache holds.",
      "factIds": [
        "fact.flotilla.hidden-cache"
      ],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1"
      ]
    },
    {
      "id": "text.journal.tg04.40",
      "questId": "quest.tg.tg04",
      "surface": "journal",
      "text": "I was seen taking the list. Ninx-Ossa will not deal with me again.",
      "factIds": [],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1"
      ]
    },
    {
      "id": "text.journal.tg04.90",
      "questId": "quest.tg.tg04",
      "surface": "journal",
      "text": "Ninx-Ossa is dead.",
      "factIds": [],
      "groundedIn": [
        "fact.lighter-flotilla.contents-loot-l1-1"
      ]
    }
  ]
}
