   ],
   "links": []
  },
  {
   "schemaVersion": 1,
   "id": "pool.greenspring-spring-terms.start",
   "type": "dialogue",
   "speaker": null,
   "keys": {
    "topic": "topic.greenspring-spring-terms"
   },
   "words": "Two convocation delegations sleep in my beds. They do not pay pitch rent at Nine-Trunks. They want the use of the spring written down before the next convocation. Ask the spring-keeper, Im-Moro, on what terms the spring is kept.",
   "available": [
    {
     "questState": [
      "quest.local.lh37",
      "unstarted"
     ]
    }
   ],
   "onDelivered": [
    {
