   ],
   "links": []
  },
  {
   "schemaVersion": 1,
   "id": "pool.greenspring-drinker.default",
   "type": "dialogue",
   "speaker": null,
   "keys": {
    "topic": "topic.greenspring-drinker"
   },
   "words": "A body lay in the spring water. Some at the spring would rather it was not spoken of.",
