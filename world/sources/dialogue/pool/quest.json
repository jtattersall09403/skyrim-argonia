   ],
   "links": []
  },
  {
   "schemaVersion": 1,
   "id": "pool.greenspring-spring-terms.default",
   "type": "dialogue",
   "speaker": null,
   "keys": {
    "topic": "topic.greenspring-spring-terms"
   },
   "words": "The water costs nothing here. The tribe has always given it free.",
