  {
   "schemaVersion": 1,
   "id": "pool.greenspring-drinker.start",
   "type": "dialogue",
   "speaker": null,
   "keys": {
    "topic": "topic.greenspring-drinker"
   },
   "words": "We lifted a body out of the spring. The whole interior drinks that water without boiling it. Two households at the spring do not want the body mentioned. Ask Mee-Sei and Tsono-Ra what they saw, then come back to me.",
   "available": [
    {
     "questState": [
      "quest.local.lh38",
      "unstarted"
     ]
    }
   ],
   "onDelivered": [
    {
