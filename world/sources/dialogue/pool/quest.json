   "type": "dialogue",
   "speaker": null,
   "keys": {
    "topic": "topic.greenspring-written-terms"
   },
   "words": "The water is free to anyone who comes. Beds and rope are paid for. That is how it will be set down for the convocation at Nine-Trunks.",
