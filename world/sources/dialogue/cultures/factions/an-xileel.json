   "values": [
    {
     "text": "An ending, recorded.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    }
   ],
   "contempts": [
    {
     "text": "Holders who extend accounts without assessment.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
