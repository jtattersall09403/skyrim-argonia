    {
     "text": "Speaks of a debtor as a balance.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    }
   ],
   "taboos": [
    {
     "text": "Calling an Owing slavery.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    }
