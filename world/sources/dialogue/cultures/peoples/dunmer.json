{
 "schemaVersion": 1,
 "domain": "culture-sheet",
 "_": "People sheets for Dunmer in the slice roster (lane 2.5a2). Upbringings inferred from roster roles and zones.",
 "entries": [
  {
   "id": "culture.people.dunmer-marsh-born",
   "level": "people",
   "name": "Dunmer, Argonia-born",
   "parent": "culture.province.black-marsh",
   "race": "dunmer",
   "upbringing": "marsh-born",
   "norms": [
    {
     "text": "Three generations in the marsh; Jel is spoken better than Dunmeris and that is a point of pride.",
     "source": "inferred"
    },
    {
     "text": "The quarter keeps its own militia hall and its own calendar beside the marsh one.",
     "source": "inferred"
    },
    {
     "text": "Status is read from the honorific: sera to a peer, muthsera upward.",
     "source": "inferred"
    }
   ],
   "taboos": [
    {
     "text": "Asking which side of the coffle a family stood.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    },
    {
     "text": "Calling Morrowind home.",
     "source": "inferred"
    }
   ],
   "values": [
    {
     "text": "Lineage and the counting house.",
     "source": "world/sources/lore/stormhold.md"
    },
    {
     "text": "Belonging here without apology.",
     "source": "inferred"
    }
   ],
   "contempts": [
    {
     "text": "Visiting Morrowind factors who treat them as colonists.",
     "source": "inferred"
    },
    {
     "text": "Nativists who count them as foreign.",
     "source": "world/sources/lore/an-xileel.md"
    }
   ],
   "opinions": {
    "place": {
     "lean": 2,
     "text": "Stormhold and Thorn are home; Tear is a market across the river.",
     "source": "world/sources/lore/stormhold.md"
    },
    "work": {
     "lean": 1,
     "text": "The crystal trade and the counting houses pay; the fields are another matter.",
     "source": "world/sources/lore/stormhold.md"
    },
    "people": {
     "lean": 0,
     "text": "Argonian neighbours, Argonian in-laws; the line is less clear than outsiders think.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    },
    "faction": {
     "lean": -1,
     "text": "The Wardens tolerate the quarter and tax it.",
     "source": "world/sources/lore/an-xileel.md"
    },
    "hist": {
     "lean": 1,
     "text": "The square's tree is respected; no Dunmer pretends to hear it.",
     "source": "world/sources/lore/stormhold.md"
    },
    "empire": {
     "lean": 0,
     "text": "The Empire is a name in old deeds.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    },
    "trade": {
     "lean": 1,
     "text": "The Tear road and the river are real trade and unsentimental.",
     "source": "world/sources/lore/extrapolation/argonia-4e201-state.md"
    },
    "danger": {
     "lean": -1,
     "text": "The border is cold; both sides want it kept cold.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    },
    "rumour": {
     "lean": 0,
     "text": "Who is marrying across the quarter line.",
     "source": "inferred"
    },
    "directions": {
     "lean": 1,
     "text": "Directions by bridge and ravine, in both languages.",
     "source": "world/sources/lore/stormhold.md"
    }
   },
   "speech": {
    "addressTerms": [
     {
      "text": "Sera, muthsera, serjo by rank.",
      "source": "inferred"
     },
     {
      "text": "Argonian neighbours by their Jel names, correctly.",
      "source": "inferred"
     }
    ],
    "formality": "formal",
    "oaths": [
     {
      "text": "By my grandmother's ashes.",
      "source": "inferred"
     }
    ],
    "neverSaid": [
     {
      "text": "The trade of their great-grandparents.",
      "source": "world/sources/lore/topics/labour-and-bondage.md"
     }
    ],
    "registerRef": "docs/standards/text/culture-registers.md#2-upbringing--culture-layer--who-raised-them-and-when"
   },
   "talk": {
    "grievances": [
     {
      "text": "Every census counts them as foreign.",
      "source": "inferred"
     }
    ],
    "rumours": [
     {
      "text": "A Redoran factor from Tear has been asking about old Dres deeds.",
      "source": "inferred"
     }
    ]
   },
   "views": [
    {
     "node": "culture.people.dunmer-newcomer",
     "lean": -1,
     "text": "Morrowind cousins who explain the marsh badly.",
     "source": "inferred"
    },
    {
     "node": "culture.people.argonian-port",
     "lean": 1,
     "text": "Business partners and in-laws.",
     "source": "inferred"
    },
    {
     "node": "culture.faction.thorn-ash-reed-accord",
     "lean": 1,
     "text": "Saltrice title argued in Jel, at last.",
     "source": "inferred"
    }
   ],
   "deviationRate": 0.2
  },
  {
   "id": "culture.people.dunmer-dres-held",
   "level": "people",
   "name": "Dunmer, Dres-held claimant families",
   "parent": "culture.province.black-marsh",
   "race": "dunmer",
   "upbringing": "dres-held",
   "norms": [
    {
     "text": "Property is spoken of in antique legal form, whether land or labour.",
     "source": "inferred"
    },
    {
     "text": "Holdings are kept, not repaired; the masonry is Dres and so is the grievance.",
     "source": "inferred"
    }
   ],
   "taboos": [
    {
     "text": "Conceding that the abolition was just.",
     "source": "inferred"
    },
    {
     "text": "Naming a debtor as a slave.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    }
   ],
   "values": [
    {
     "text": "Title and lineage over present law.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    },
    {
     "text": "The Owing ledger, which is lawful.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    }
   ],
   "contempts": [
    {
     "text": "Chainbreakers and their bonfires.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    },
    {
     "text": "A state that would not exist without stolen land.",
     "source": "inferred"
    }
   ],
   "opinions": {
    "place": {
     "lean": 1,
     "text": "The holding is theirs by a deed no court will read.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    },
    "work": {
     "lean": 1,
     "text": "Workers owe; the ledger says how much.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    },
    "people": {
     "lean": -1,
     "text": "Argonians as labour, spoken of politely.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    },
    "faction": {
     "lean": -2,
     "text": "The Wardens abolished what made the north rich.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    },
    "hist": {
     "lean": -1,
     "text": "A tree the workers favour.",
     "source": "inferred"
    },
    "empire": {
     "lean": 0,
     "text": "The Empire at least respected title.",
     "source": "inferred"
    },
    "trade": {
     "lean": 1,
     "text": "Saltrice still sells in Tear.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    },
    "danger": {
     "lean": -1,
     "text": "The Chainbreakers and the Accord.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    },
    "rumour": {
     "lean": 0,
     "text": "A claimant's factor has been fed at Branchmont again.",
     "source": "inferred"
    },
    "directions": {
     "lean": 0,
     "text": "Directions by holding and boundary stone.",
     "source": "inferred"
    }
   },
   "speech": {
    "addressTerms": [
     {
      "text": "Serjo to themselves, expected; sera to equals.",
      "source": "inferred"
     },
     {
      "text": "Workers by number or role.",
      "source": "inferred"
     }
    ],
    "formality": "ceremonial",
    "oaths": [
     {
      "text": "By House and deed.",
      "source": "inferred"
     }
    ],
    "neverSaid": [
     {
      "text": "Slave.",
      "source": "world/sources/lore/topics/labour-and-bondage.md"
     },
     {
      "text": "That the law is no longer behind them.",
      "source": "inferred"
     }
    ],
    "registerRef": "docs/standards/text/culture-registers.md#2-upbringing--culture-layer--who-raised-them-and-when"
   },
   "talk": {
    "grievances": [
     {
      "text": "Their title is unrecognised by every court in the province.",
      "source": "world/sources/lore/topics/foreign-powers.md"
     }
    ],
    "rumours": [
     {
      "text": "The Accord means to file on the Branchmont fields.",
      "source": "inferred"
     }
    ]
   },
   "views": [
    {
     "node": "culture.faction.dres-remnant",
     "lean": 2,
     "text": "Their own, still pressing the claim.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    },
    {
     "node": "culture.faction.chainbreakers",
     "lean": -2,
     "text": "Arsonists of lawful records.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    },
    {
     "node": "culture.people.argonian-freed",
     "lean": -1,
     "text": "Debtors.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    }
   ],
   "deviationRate": 0.15
  },
  {
   "id": "culture.people.dunmer-newcomer",
   "level": "people",
   "name": "Dunmer, newcomer from Morrowind",
   "parent": "culture.province.black-marsh",
   "race": "dunmer",
   "upbringing": "newcomer",
   "norms": [
    {
     "text": "Business first; the factor is here for the season and the season only.",
     "source": "inferred"
    },
    {
     "text": "Redoran manners: full sentences, contempt delivered formally.",
     "source": "inferred"
    }
   ],
   "taboos": [
    {
     "text": "Mentioning the Accession War to an Argonian host.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    }
   ],
   "values": [
    {
     "text": "House standing and a good price.",
     "source": "inferred"
    }
   ],
   "contempts": [
    {
     "text": "Marsh-born Dunmer who have gone native.",
     "source": "inferred"
    },
    {
     "text": "Mud.",
     "source": "inferred"
    }
   ],
   "opinions": {
    "place": {
     "lean": -1,
     "text": "A wet border with good saltrice and bad roads.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    },
    "work": {
     "lean": 0,
     "text": "Trade, counted carefully.",
     "source": "inferred"
    },
    "people": {
     "lean": -1,
     "text": "Argonians are owed courtesy and watched.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    },
    "faction": {
     "lean": -1,
     "text": "The Wardens are a border screen best left untested.",
     "source": "world/sources/lore/extrapolation/argonia-4e201-state.md"
    },
    "hist": {
     "lean": -1,
     "text": "A tree. Respected, at a distance.",
     "source": "inferred"
    },
    "empire": {
     "lean": -1,
     "text": "The Empire lost and left.",
     "source": "world/sources/lore/topics/foreign-powers.md"
    },
    "trade": {
     "lean": 1,
     "text": "Traders on the Tear road profit both ways.",
     "source": "world/sources/lore/extrapolation/argonia-4e201-state.md"
    },
    "danger": {
     "lean": -1,
     "text": "Disease and drowning.",
     "source": "world/sources/lore/topics/labour-and-bondage.md"
    },
    "rumour": {
     "lean": 0,
     "text": "News from Tear arrives before news from Helstrom.",
     "source": "inferred"
    },
    "directions": {
     "lean": -1,
     "text": "Asks for directions and repeats them wrong.",
     "source": "inferred"
    }
   },
   "speech": {
    "addressTerms": [
     {
      "text": "Sera; muthsera to a Vicecanon.",
      "source": "inferred"
     },
     {
      "text": "Exonyms for places locals name in Jel.",
      "source": "inferred"
     }
    ],
    "formality": "formal",
    "oaths": [
     {
      "text": "By Almalexia, from old habit.",
      "source": "inferred"
     }
    ],
    "neverSaid": [
     {
      "text": "That the Argonians nearly took Mournhold.",
      "source": "world/sources/lore/topics/foreign-powers.md"
     }
    ],
    "registerRef": "docs/standards/text/culture-registers.md#2-upbringing--culture-layer--who-raised-them-and-when"
   },
   "talk": {
    "grievances": [
     {
      "text": "Customs at the Tear road are slow and arbitrary.",
      "source": "world/sources/lore/extrapolation/argonia-4e201-state.md"
     }
    ],
    "rumours": [
     {
      "text": "The Argonian screen on the border is thinner than it looks.",
      "source": "world/sources/lore/extrapolation/argonia-4e201-state.md"
     }
    ]
   },
   "views": [
    {
     "node": "culture.people.dunmer-marsh-born",
     "lean": -1,
     "text": "Speak Jel at home; embarrassing.",
     "source": "inferred"
    },
    {
     "node": "culture.faction.morrowind-veterans",
     "lean": 0,
     "text": "Old soldiers who should have gone home.",
     "source": "inferred"
    }
   ],
   "deviationRate": 0.2
  }
 ]
