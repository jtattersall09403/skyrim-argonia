    "world/sources/registries/locks.json"
   ],
   "homeOf": "lock."
  },
  "physical-materials": {
   "schema": "physical-materials.v1.schema.json",
   "files": [
    "world/sources/registries/physical-materials.json"
   ],
   "homeOf": "material."
  },
  "hazard-volumes": {
   "schema": "hazard-volumes.v1.schema.json",
   "files": [
    "world/sources/registries/hazard-volumes.json"
   ],
   "homeOf": "hazard."
  },
  "grave-stakes": {
   "schema": "grave-stakes.v1.schema.json",
   "files": [
    "world/sources/registries/grave-stakes.json"
   ],
   "homeOf": "stake."
  },
  "loot-rules": {
   "schema": "loot-rules.v1.schema.json",
   "files": [
    "world/sources/registries/loot-rules.json"
   ],
   "homeOf": "blanket."
  },
  "culture-sheet": {
   "schema": "culture-sheet.v1.schema.json",
   "files": [
    "world/sources/dialogue/cultures/**/*.json"
   ],
   "homeOf": "culture."
  },
  "stance": {
   "schema": "stance.v1.schema.json",
   "files": [
    "world/sources/dialogue/stance/*.json"
   ],
   "homeOf": "stance rows by npc id"
  },
  "place-crime": {
   "schema": "place-crime.v1.schema.json",
   "within": "catalogue places[] (zones, watch)"
  },
  "boat-classes": {
   "schema": "boat-classes.v1.schema.json",
   "files": [
    "world/sources/vocab/boat-classes.json"
   ],
   "homeOf": "boat classes (by id)"
  },
  "boats": {
   "schema": "boats.v1.schema.json",
   "files": [
    "world/sources/placement/boats.json"
