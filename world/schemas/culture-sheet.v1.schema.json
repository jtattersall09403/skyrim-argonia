{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "world-schema/culture-sheet.v1",
 "title": "Culture sheets (2.5a, decision 0139): one node of the hierarchy each",
 "type": "object",
 "required": [
  "schemaVersion",
  "domain",
  "entries"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "domain": {
   "const": "culture-sheet"
  },
  "_": {
   "type": "string"
  },
  "entries": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/sheet"
   }
  }
 },
 "$defs": {
  "source": {
   "type": "string",
   "pattern": "^(inferred|world/sources/lore/[a-z0-9/_.-]+\\.md(#[a-z0-9-]+)?|world/sources/catalogue/[a-z0-9_.-]+\\.json#[a-z0-9][a-z0-9._-]*|docs/quests/40-factions\\.md#[a-z0-9-]+)$"
  },
  "trait": {
   "type": "object",
   "required": [
    "text",
    "source"
   ],
   "additionalProperties": false,
   "properties": {
    "text": {
     "type": "string",
     "minLength": 3
    },
    "source": {
     "$ref": "#/$defs/source"
    }
   }
  },
  "lean": {
   "type": "integer",
   "minimum": -2,
   "maximum": 2,
   "description": "-2 hostile, -1 cool, 0 indifferent, 1 warm, 2 devoted"
  },
  "cultureId": {
   "type": "string",
   "pattern": "^culture\\.(province|region|people|faction|office|settlement|group|household)\\.[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$"
  },
  "topicClass": {
   "enum": [
    "place",
    "work",
    "people",
    "faction",
    "hist",
    "empire",
    "trade",
    "danger",
    "rumour",
    "directions"
   ]
  },
  "opinion": {
   "type": "object",
   "required": [
    "lean",
    "text",
    "source"
   ],
   "additionalProperties": false,
   "properties": {
    "lean": {
     "$ref": "#/$defs/lean"
    },
    "text": {
     "type": "string",
     "minLength": 3
    },
    "source": {
     "$ref": "#/$defs/source"
    }
   }
  },
  "view": {
   "type": "object",
   "required": [
    "node",
    "lean",
    "text",
    "source"
   ],
   "additionalProperties": false,
   "properties": {
    "node": {
     "$ref": "#/$defs/cultureId"
    },
    "lean": {
     "$ref": "#/$defs/lean"
    },
    "text": {
     "type": "string"
    },
    "source": {
     "$ref": "#/$defs/source"
    }
   }
  },
  "sheet": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "level",
    "name",
    "parent",
    "norms",
    "taboos",
    "values",
    "contempts",
    "opinions",
    "speech",
    "talk",
    "views",
    "deviationRate"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/cultureId"
    },
    "level": {
     "enum": [
      "province",
      "region",
      "people",
      "faction",
      "office",
      "settlement",
      "group",
      "household"
     ]
    },
    "name": {
     "type": "string"
    },
    "parent": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/cultureId"
      }
     ]
    },
    "race": {
     "type": "string"
    },
    "upbringing": {
     "type": "string"
    },
    "regionId": {
     "type": "string",
     "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "factionId": {
     "type": "string",
     "pattern": "^faction\\."
    },
    "rank": {
     "type": [
      "string",
      "null"
     ]
    },
    "placeId": {
     "type": "string",
     "pattern": "^place\\."
    },
    "members": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^npc\\."
     }
    },
    "norms": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/trait"
     }
    },
    "taboos": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/trait"
     }
    },
    "values": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/trait"
     }
    },
    "contempts": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/trait"
     }
    },
    "opinions": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "place",
       "work",
       "people",
       "faction",
       "hist",
       "empire",
       "trade",
       "danger",
       "rumour",
       "directions"
      ]
     },
     "additionalProperties": {
      "$ref": "#/$defs/opinion"
     }
    },
    "speech": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "addressTerms",
      "formality",
      "oaths",
      "neverSaid"
     ],
     "properties": {
      "addressTerms": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/trait"
       }
      },
      "formality": {
       "enum": [
        "low",
        "plain",
        "formal",
        "ceremonial"
       ]
      },
      "oaths": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/trait"
       }
      },
      "neverSaid": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/trait"
       }
      },
      "registerRef": {
       "type": "string",
       "pattern": "^docs/standards/text/culture-registers\\.md#"
      }
     }
    },
    "talk": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "grievances",
      "rumours"
     ],
     "properties": {
      "grievances": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/trait"
       }
      },
      "rumours": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/trait"
       }
      }
     }
    },
    "views": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/view"
     }
    },
    "deviationRate": {
     "type": "number",
     "minimum": 0,
     "maximum": 0.5,
     "description": "planned share of this group's members who deviate per topic class"
    },
    "dissent": {
     "type": "array",
     "description": "recorded dissenters: a member who holds a stance against this node's norm (the stance row carries the matching deviation)",
     "items": {
      "type": "object",
      "required": ["personId", "topic", "lean", "text", "source"],
      "additionalProperties": false,
      "properties": {
       "personId": {"type": "string", "pattern": "^npc\\."},
       "topic": {"$ref": "#/$defs/topicClass"},
       "lean": {"$ref": "#/$defs/lean"},
       "text": {"type": "string", "minLength": 3},
       "source": {"$ref": "#/$defs/source"}
      }
     }
    }
   }
  }
 }
}
