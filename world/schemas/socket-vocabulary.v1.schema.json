{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "world-schema/socket-vocabulary.v1",
 "title": "The socket vocabulary (decisions 0103 and 0104)",
 "type": "object",
 "required": [
  "schemaVersion",
  "socketKinds",
  "stationClasses",
  "doorTypes",
  "serviceSurfaces",
  "interactKinds",
  "itemClasses",
  "containerClasses",
  "fillRules",
  "fillRulesSource",
  "plantClasses",
  "valueBands"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "socketKinds": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "uniqueItems": true
  },
  "stationClasses": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "kit",
     "assetSource"
    ],
    "properties": {
     "kit": {
      "type": [
       "string",
       "null"
      ]
     },
     "assetSource": {
      "type": "string"
     }
    },
    "if": {
     "properties": {
      "assetSource": {
       "const": "sourcing"
      }
     }
    },
    "then": {
     "required": [
      "register"
     ]
    }
   }
  },
  "serviceSurfaces": {
   "type": "object",
   "required": [
    "nameFamilies"
   ],
   "properties": {
    "nameFamilies": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "interactKinds": {
   "const": [
    "customer",
    "station"
   ]
  },
  "doorTypes": {
   "type": "object",
   "required": [
    "load",
    "swing"
   ]
  },
  "fillRulesSource": {
   "const": "world/sources/registries/loot-rules.json"
  },
  "fillRules": {
   "type": "object",
   "required": [
    "authored"
   ],
   "propertyNames": {
    "pattern": "^authored$"
   }
  },
  "plantClasses": {
   "type": "object",
   "additionalProperties": {
    "oneOf": [
     {
      "type": "string"
     },
     {
      "type": "object",
      "required": [
       "species",
       "ingredient",
       "regrowDays"
      ],
      "properties": {
       "species": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string"
        }
       },
       "ingredient": {
        "type": "string",
        "pattern": "^item\\."
       },
       "regrowDays": {
        "type": "number",
        "exclusiveMinimum": 0
       }
      }
     }
    ]
   }
  }
 }
}
