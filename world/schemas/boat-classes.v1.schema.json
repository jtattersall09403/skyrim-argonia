{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "world-schema/boat-classes.v1",
 "title": "Boat classes, the BoatClass home table (2.15b, 0159)",
 "type": "object",
 "required": ["schemaVersion", "mooringMarginM", "recovery", "classes"],
 "properties": {
  "schemaVersion": {"const": 1},
  "mooringMarginM": {"type": "number", "minimum": 0},
  "recovery": {"type": "object", "required": ["percent", "minGold"]},
  "classes": {"type": "array", "minItems": 1, "items": {
   "type": "object",
   "required": ["id", "built", "waterBands", "lengthM", "beamM", "draughtM", "cruiseMS", "maxWaveHeightM",
                "rapids", "seats", "crewPose", "hullAssetIds", "priceGold", "sellerKinds"],
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "built": {"type": "boolean"},
    "waterBands": {"type": "array", "items": {"type": "string"}},
    "lengthM": {"type": "number", "exclusiveMinimum": 0},
    "beamM": {"type": "number", "exclusiveMinimum": 0},
    "draughtM": {"type": "number", "exclusiveMinimum": 0},
    "cruiseMS": {"type": "number", "exclusiveMinimum": 0},
    "maxWaveHeightM": {"type": "number", "exclusiveMinimum": 0},
    "rapids": {"enum": ["none", "down-only"]},
    "seats": {"type": "integer", "minimum": 1},
    "crewPose": {"type": "string"},
    "hullAssetIds": {"type": "array", "items": {"type": "string"}},
    "priceGold": {"type": "integer", "minimum": 0},
    "sellerKinds": {"type": "array", "items": {"type": "string"}}
   }}}
 }
}
