{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "world-schema/place-crime.v1",
 "title": "A catalogue place record's private zones and watch (2.10a, decision 0151 item 3; contract lanes/2.10/briefs/rules.md)",
 "type": "object",
 "properties": {
  "zones": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "owner",
     "hours",
     "volume"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^zone\\.[a-z0-9-]+(\\.[a-z0-9-]+)+$"
     },
     "owner": {
      "$ref": "world-schema/owner-ref.v1"
     },
     "hours": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "array",
        "items": {
         "type": "number",
         "minimum": 0,
         "maximum": 24
        },
        "minItems": 2,
        "maxItems": 2
       }
      ]
     },
     "admits": {
      "type": "object",
      "required": [
       "faction",
       "rankAtLeast"
      ],
      "additionalProperties": false,
      "properties": {
       "faction": {
        "type": "string",
        "pattern": "^faction\\."
       },
       "rankAtLeast": {
        "type": "string"
       }
      }
     },
     "volume": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "kind",
         "center",
         "size",
         "yawDeg"
        ],
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "box"
         },
         "center": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
         },
         "size": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
         },
         "yawDeg": {
          "type": "number"
         }
        }
       },
       {
        "type": "object",
        "required": [
         "kind",
         "cell"
        ],
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "interior"
         },
         "cell": {
          "type": "string",
          "minLength": 1
         }
        }
       }
      ]
     }
    }
   }
  },
  "watch": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "required": [
      "answers",
      "radiusM",
      "custodyPost",
      "region"
     ],
     "additionalProperties": false,
     "properties": {
      "answers": {
       "$ref": "world-schema/owner-ref.v1"
      },
      "radiusM": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "custodyPost": {
       "type": "string",
       "minLength": 1
      },
      "custodyLight": {
       "type": "object",
       "description": "The lit fixture already placed in the layout that lights the custody post: a waking player is set between it and the post.",
       "required": ["fixture", "at"],
       "additionalProperties": false,
       "properties": {
        "fixture": { "type": "string", "minLength": 1, "description": "The layout uid of the lantern, candle or brazier." },
        "at": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "Its [x, z] metres in the layout." }
       }
      },
      "region": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   ]
  }
 }
}
