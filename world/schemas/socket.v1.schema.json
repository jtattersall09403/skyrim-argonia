{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "world-schema/socket.v1",
 "title": "A placed interactable: a layout socket op (decisions 0103 and 0104)",
 "type": "object",
 "required": [
  "op",
  "id",
  "kind"
 ],
 "properties": {
  "op": {
   "const": "socket"
  },
  "id": {
   "type": "string",
   "pattern": "^(socket|fill|yard)\\.[a-z0-9-]+(\\.[a-z0-9]+(-[a-z0-9]+)*)*$"
  },
  "kind": {
   "enum": [
    "npc",
    "idle",
    "item",
    "container",
    "station",
    "sign",
    "encounter",
    "fauna",
    "ambience",
    "marker",
    "plant",
    "mooring"
   ]
  },
  "at": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "host": {
   "type": "string"
  },
  "parcel": {
   "type": "string",
   "pattern": "^parcel\\."
  },
  "fills": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^promise\\."
   },
   "uniqueItems": true
  },
  "owner": {
   "type": [
    "string",
    "null"
   ]
  },
  "valueTier": {
   "enum": [
    null,
    "trivial",
    "low",
    "moderate",
    "high",
    "precious"
   ]
  },
  "stationClass": {
   "type": "string"
  },
  "pointsTo": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^(route|place)\\."
   }
  },
  "schedule": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "socketId": {
      "type": "string",
      "pattern": "^socket\\."
     }
    }
   }
  },
  "lock": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^lock\\."
  },
  "item": {
   "type": "string",
   "pattern": "^item\\."
  },
  "plantClass": {
   "type": "string"
  },
  "regrowDays": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "fillRule": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^(authored|blanket\\.[a-z0-9-]+)$"
  },
  "lootTable": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/lootRow"
     }
    },
    "frozenFrom": {
     "type": "string",
     "pattern": "^blanket\\."
    },
    "band": {
     "enum": ["D1", "D2", "D3", "D4", "D5"]
    },
    "storyNote": {
     "type": "string"
    },
    "itemClasses": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "valueBand": {
     "type": "string"
    }
   }
  }
 },
 "anyOf": [
  {
   "required": [
    "at"
   ]
  },
  {
   "required": [
    "host"
   ]
  }
 ],
 "$defs": {
  "lootRow": {
   "type": "object",
   "required": [
    "item",
    "count"
   ],
   "additionalProperties": false,
   "properties": {
    "item": {
     "type": "string",
     "pattern": "^item\\."
    },
    "count": {
     "type": "integer",
     "minimum": 1
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "const": "plant"
     }
    }
   },
   "then": {
    "required": [
     "plantClass"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "not": {
       "const": "plant"
      }
     }
    }
   },
   "then": {
    "not": {
     "required": [
      "regrowDays"
     ]
    }
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "not": {
       "enum": [
        "container"
       ]
      }
     }
    }
   },
   "then": {
    "not": {
     "required": [
      "lock"
     ]
    }
   }
  }
 ]
}
