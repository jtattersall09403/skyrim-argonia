{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "world-schema/locks.v1",
 "title": "Lock records (2.3a decision 9; 2.10a class, trap, opens, owner)",
 "type": "object",
 "required": [
  "schemaVersion",
  "domain",
  "entries"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "domain": {
   "const": "lock"
  },
  "entries": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "level",
     "key",
     "class",
     "opens",
     "owner"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^lock\\."
     },
     "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
     },
     "class": {
      "enum": [
       "none",
       "simple",
       "hard",
       "unpickable-key",
       "quest-sealed"
      ]
     },
     "key": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^item\\."
     },
     "spellKey": {
      "type": "string"
     },
     "trap": {
      "type": "string",
      "pattern": "^trap\\."
     },
     "opens": {
      "type": "object",
      "required": [
       "place",
       "ref"
      ],
      "additionalProperties": false,
      "properties": {
       "place": {
        "type": "string",
        "pattern": "^place\\."
       },
       "ref": {
        "type": "string",
        "pattern": "^(socket|door|fill|yard)\\."
       }
      }
     },
     "owner": {
      "$ref": "world-schema/owner-ref.v1"
     }
    }
   }
  }
 }
}
