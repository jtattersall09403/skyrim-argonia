   "elevation_floor_m": 4.0,
   "elevation_summit_m": 12.0,
   "roughness_m": 0.8,
   "cliff_share": 0.02,
   "wetness": 0.9,
   "biome": "Tidal bayou and saltrice marsh",
   "climate": "Hot and humid year-round, with a monsoon and tidal flooding",
   "culture_id": "plum",
