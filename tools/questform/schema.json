{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "argonia/questform/1",
  "title": "The quest form: one quest as data, at the Morrowind-level ceiling (docs/design/quest-form.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "quest", "stages", "objectives", "refs", "lines", "triggers", "must_live"],
  "properties": {
    "version": {"const": 1},
    "names": {"type": "object", "additionalProperties": {"$ref": "#/$defs/text"}},
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "editor_id", "name", "kind", "start"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "editor_id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["main", "faction", "minor"]},
        "start": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["by", "stage"],
              "properties": {"by": {"const": "game"}, "stage": {"$ref": "#/$defs/stage"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["by", "quest", "quest_stage", "stage"],
              "properties": {
                "by": {"const": "quest_stage"},
                "quest": {"$ref": "#/$defs/id"},
                "quest_stage": {"$ref": "#/$defs/stage"},
                "stage": {"$ref": "#/$defs/stage"}
              }
            }
          ]
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "shown", "journal", "ending", "results"],
        "properties": {
          "number": {"$ref": "#/$defs/stage"},
          "shown": {"type": "boolean"},
          "journal": {"type": ["string", "null"]},
          "ending": {"enum": ["none", "completed", "failed"]},
          "results": {"$ref": "#/$defs/results"}
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "text", "shown_at", "completed_at", "targets"],
        "properties": {
          "number": {"type": "integer", "minimum": 0},
          "text": {"$ref": "#/$defs/text"},
          "shown_at": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}},
          "completed_at": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
          "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "placement", "enabled"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["person", "thing", "door", "marker"]},
          "placement": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["existing"],
                "properties": {"existing": {"$ref": "#/$defs/id"}}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["base"],
                "properties": {
                  "base": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "id"],
                    "properties": {
                      "kind": {"enum": ["template_person", "item", "existing_base"]},
                      "id": {"$ref": "#/$defs/id"}
                    }
                  },
                  "anchor": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["near", "rule"],
                        "properties": {"near": {"$ref": "#/$defs/id"}, "rule": {"$ref": "#/$defs/rule"}}
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["place", "rule"],
                        "properties": {"place": {"$ref": "#/$defs/id"}, "rule": {"$ref": "#/$defs/rule"}}
                      }
                    ]
                  },
                  "container": {"$ref": "#/$defs/id"},
                  "carried_by": {"$ref": "#/$defs/id"}
                }
              }
            ]
          },
          "enabled": {"type": "boolean"},
          "hostile": {"type": "boolean"},
          "lock": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level"],
            "properties": {"level": {"enum": ["novice", "apprentice", "adept", "expert", "master", "key"]},
                           "key": {"$ref": "#/$defs/id"}}
          },
          "owner": {"$ref": "#/$defs/id"},
          "contents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item", "count"],
              "properties": {"item": {"$ref": "#/$defs/id"}, "count": {"type": "integer", "minimum": 1}}
            }
          },
          "name": {"$ref": "#/$defs/text"},
          "destination": {"$ref": "#/$defs/text"},
          "text": {"$ref": "#/$defs/text"},
          "at": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cell", "interior", "x", "y", "z"],
            "properties": {
              "cell": {"$ref": "#/$defs/id"},
              "interior": {"type": "boolean"},
              "x": {"type": "number"},
              "y": {"type": "number"},
              "z": {"type": "number"}
            }
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "speaker", "kind", "prompt", "text", "written", "conditions", "results", "first_stage",
                     "last_stage", "answers"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "speaker": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["greeting", "topic", "answer", "speaks_first"]},
          "prompt": {"type": ["string", "null"]},
          "text": {"$ref": "#/$defs/text"},
          "written": {"type": "boolean"},
          "conditions": {"$ref": "#/$defs/conditions"},
          "results": {"$ref": "#/$defs/results"},
          "first_stage": {"$ref": "#/$defs/stage"},
          "last_stage": {"$ref": "#/$defs/stage"},
          "answers": {"type": "array", "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "ref", "prerequisite", "sets"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "kind": {"enum": ["take", "use", "death"]},
              "ref": {"$ref": "#/$defs/id"},
              "prerequisite": {"$ref": "#/$defs/stage"},
              "sets": {"$ref": "#/$defs/stage"},
              "choice": {"type": "boolean"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "quest", "quest_stage", "prerequisite", "sets"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "kind": {"const": "quest_stage"},
              "quest": {"$ref": "#/$defs/id"},
              "quest_stage": {"$ref": "#/$defs/stage"},
              "prerequisite": {"$ref": "#/$defs/stage"},
              "sets": {"$ref": "#/$defs/stage"}
            }
          }
        ]
      }
    },
    "must_live": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "fail_stage", "main_message"],
        "properties": {
          "ref": {"$ref": "#/$defs/id"},
          "fail_stage": {"$ref": "#/$defs/stage"},
          "main_message": {"type": "boolean"},
          "message": {"$ref": "#/$defs/text"},
          "from": {"$ref": "#/$defs/stage"},
          "to": {"$ref": "#/$defs/stage"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "stage": {"type": "integer", "minimum": 0, "maximum": 255},
    "rule": {"enum": ["surface", "navmesh"]},
    "skill": {"enum": ["Speech", "Sneak", "Lockpicking", "Pickpocket", "Alchemy", "OneHanded", "TwoHanded", "Archery",
                       "Block", "HeavyArmor", "LightArmor", "Smithing", "Enchanting", "Alteration", "Conjuration",
                       "Destruction", "Illusion", "Restoration"]},
    "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "condition": {
      "oneOf": [
        {"$ref": "#/$defs/c_quest_stage"},
        {"$ref": "#/$defs/c_number"},
        {"$ref": "#/$defs/c_faction"},
        {"$ref": "#/$defs/c_rank"},
        {"$ref": "#/$defs/c_item"},
        {"$ref": "#/$defs/c_gold"},
        {"$ref": "#/$defs/c_skill"},
        {"$ref": "#/$defs/c_ref"},
        {"$ref": "#/$defs/c_regard"},
        {"$ref": "#/$defs/c_player"},
        {"$ref": "#/$defs/c_met"}
      ]
    },
    "c_player": {
      "type": "object", "additionalProperties": false, "required": ["is", "value"],
      "properties": {"not": {"type": "boolean"}, "is": {"enum": ["race_is", "sex_is"]}, "value": {"$ref": "#/$defs/id"}}
    },
    "c_met": {
      "type": "object", "additionalProperties": false, "required": ["is"],
      "properties": {"not": {"type": "boolean"}, "is": {"enum": ["spoken_before", "not_spoken_before"]}}
    },
    "c_quest_stage": {
      "type": "object", "additionalProperties": false, "required": ["is", "quest", "stage"],
      "properties": {"not": {"type": "boolean"}, "is": {"enum": ["stage_is", "stage_at_least", "stage_done"]},
                     "quest": {"$ref": "#/$defs/id"}, "stage": {"$ref": "#/$defs/stage"}}
    },
    "c_number": {
      "type": "object", "additionalProperties": false, "required": ["is", "number", "op", "value"],
      "properties": {"is": {"const": "number_compare"}, "number": {"$ref": "#/$defs/id"},
                     "op": {"enum": ["=", "!=", "<", "<=", ">", ">="]}, "value": {"type": "number"}}
    },
    "c_faction": {
      "type": "object", "additionalProperties": false, "required": ["is", "faction"],
      "properties": {"not": {"type": "boolean"}, "is": {"const": "in_faction"}, "faction": {"$ref": "#/$defs/id"}}
    },
    "c_rank": {
      "type": "object", "additionalProperties": false, "required": ["is", "faction", "rank"],
      "properties": {"not": {"type": "boolean"}, "is": {"const": "rank_at_least"}, "faction": {"$ref": "#/$defs/id"},
                     "rank": {"type": "integer", "minimum": 0}}
    },
    "c_item": {
      "type": "object", "additionalProperties": false, "required": ["is", "item", "count"],
      "properties": {"not": {"type": "boolean"}, "is": {"const": "item_count_at_least"}, "item": {"$ref": "#/$defs/id"},
                     "count": {"type": "integer", "minimum": 1}}
    },
    "c_gold": {
      "type": "object", "additionalProperties": false, "required": ["is", "gold"],
      "properties": {"not": {"type": "boolean"}, "is": {"const": "gold_at_least"}, "gold": {"type": "integer", "minimum": 1}}
    },
    "c_skill": {
      "type": "object", "additionalProperties": false, "required": ["is", "skill", "value"],
      "properties": {"not": {"type": "boolean"}, "is": {"const": "skill_at_least"}, "skill": {"$ref": "#/$defs/skill"},
                     "value": {"type": "integer", "minimum": 0}}
    },
    "c_ref": {
      "type": "object", "additionalProperties": false, "required": ["is", "ref"],
      "properties": {"not": {"type": "boolean"}, "is": {"enum": ["alive", "dead", "speaker_is"]}, "ref": {"$ref": "#/$defs/id"}}
    },
    "c_regard": {
      "type": "object", "additionalProperties": false, "required": ["is", "ref", "value"],
      "properties": {"not": {"type": "boolean"}, "is": {"const": "regard_at_least"}, "ref": {"$ref": "#/$defs/id"},
                     "value": {"type": "integer"}}
    },
    "result": {
      "oneOf": [
        {"$ref": "#/$defs/r_stage"},
        {"$ref": "#/$defs/r_item"},
        {"$ref": "#/$defs/r_gold"},
        {"$ref": "#/$defs/r_number"},
        {"$ref": "#/$defs/r_join"},
        {"$ref": "#/$defs/r_rank"},
        {"$ref": "#/$defs/r_regard"},
        {"$ref": "#/$defs/r_ref"},
        {"$ref": "#/$defs/r_message"},
        {"$ref": "#/$defs/r_hostile"},
        {"$ref": "#/$defs/r_start"}
      ]
    },
    "r_stage": {
      "type": "object", "additionalProperties": false, "required": ["do", "stage"],
      "properties": {"do": {"const": "set_stage"}, "stage": {"$ref": "#/$defs/stage"}}
    },
    "r_item": {
      "type": "object", "additionalProperties": false, "required": ["do", "item", "count"],
      "properties": {"do": {"enum": ["give_item", "take_item"]}, "item": {"$ref": "#/$defs/id"},
                     "count": {"type": "integer", "minimum": 1}}
    },
    "r_gold": {
      "type": "object", "additionalProperties": false, "required": ["do", "amount"],
      "properties": {"do": {"enum": ["give_gold", "take_gold"]}, "amount": {"type": "integer", "minimum": 1}}
    },
    "r_number": {
      "type": "object", "additionalProperties": false, "required": ["do", "number", "value"],
      "properties": {"do": {"enum": ["set_number", "add_number"]}, "number": {"$ref": "#/$defs/id"},
                     "value": {"type": "number"}}
    },
    "r_join": {
      "type": "object", "additionalProperties": false, "required": ["do", "faction"],
      "properties": {"do": {"const": "join_faction"}, "faction": {"$ref": "#/$defs/id"}}
    },
    "r_rank": {
      "type": "object", "additionalProperties": false, "required": ["do", "faction", "rank"],
      "properties": {"do": {"const": "set_rank"}, "faction": {"$ref": "#/$defs/id"},
                     "rank": {"type": "integer", "minimum": 0}}
    },
    "r_regard": {
      "type": "object", "additionalProperties": false, "required": ["do", "ref", "by"],
      "properties": {"do": {"const": "change_regard"}, "ref": {"$ref": "#/$defs/id"}, "by": {"type": "integer"}}
    },
    "r_ref": {
      "type": "object", "additionalProperties": false, "required": ["do", "ref"],
      "properties": {"do": {"enum": ["switch_on", "switch_off", "lock_door", "unlock_door"]},
                     "ref": {"$ref": "#/$defs/id"}}
    },
    "r_hostile": {
      "type": "object", "additionalProperties": false, "required": ["do"],
      "properties": {"do": {"const": "speaker_hostile"}}
    },
    "r_message": {
      "type": "object", "additionalProperties": false, "required": ["do", "text"],
      "properties": {"do": {"const": "show_message"}, "text": {"$ref": "#/$defs/text"}}
    },
    "r_start": {
      "type": "object", "additionalProperties": false, "required": ["do", "quest", "stage"],
      "properties": {"do": {"const": "start_quest"}, "quest": {"$ref": "#/$defs/id"},
                     "stage": {"$ref": "#/$defs/stage"}}
    }
  }
}
