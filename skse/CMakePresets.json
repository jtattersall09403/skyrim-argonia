{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-core",
      "displayName": "Build VM: the pure logic and its unit tests only",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/skse/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ARGONIA_PLUGINS": "OFF"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-dev",
      "displayName": "Game machine: the plugin (MSVC, run inside vcvars64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/../deps",
        "ARGONIA_PLUGINS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-core",
      "configurePreset": "linux-core"
    },
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev"
    }
  ],
  "testPresets": [
    {
      "name": "linux-core",
      "configurePreset": "linux-core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
